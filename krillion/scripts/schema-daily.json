{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyDive",
  "type": "object",
  "required": ["dayNumber", "date", "title", "prompts"],
  "properties": {
    "dayNumber": { "type": "integer" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string" },
    "prompts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "text", "category", "answers"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "category": { "type": "string", "enum": ["filipino", "universal"] },
          "hint": { "type": "string" },
          "answers": {
            "type": "array",
            "minItems": 25,
            "items": {
              "type": "object",
              "required": ["answer", "tier"],
              "properties": {
                "answer": { "type": "string" },
                "aliases": { "type": "array", "items": { "type": "string" } },
                "tier": { "type": "string", "enum": ["plankton", "tooclever", "schooler", "rare", "deepcut", "krillion"] },
                "quip": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
