{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "packages/pipeline/pipeline/data/generators_master.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    }
  ]
}