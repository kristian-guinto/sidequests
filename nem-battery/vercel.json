{
  "version": 2,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    }
  ]
}
